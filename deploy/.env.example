# 复制为本目录的 .env 后再改。 .env 不入库。
# 下面的 CHANGE_ME 是占位符。本机只绑 127.0.0.1 时可以先用它看健康检查。
# 只要入口不再只绑本机，就必须换成另一组口令，不能把占位符原样放到 NAS 上。
# 不要写家庭地址、真实 NAS 路径、PIN 或设备令牌。

# 网页入口只绑本机回环地址。家庭局域网试用时改成这台 NAS 的局域网地址。
# 不要写成 0.0.0.0，也不要在路由器上做端口转发。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# 数据库引导账号只在容器第一次初始化时使用，服务端不拿它连接。
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME

# 服务端使用的数据库。DB_USER 不能和 POSTGRES_BOOTSTRAP_USER 相同。
DB_NAME=guoyu_english
DB_USER=guoyu
DB_PASSWORD=CHANGE_ME

# 课程素材在宿主机上的目录，容器内只读挂到 /data/media。
# 相对路径相对 deploy/。本地默认用仓库里的演示素材。
# NAS 上改成那台机器自己的媒体目录，不要把下面的示例当成真实家庭路径。
MEDIA_HOST_DIR=../media-samples

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod

# 空库一次性引导码。CHANGE_ME 只是占位符，不是真实引导码。
# 留空表示引导关闭，不能建家庭。局域网开放前必须换成另一串，不要写 PIN。
GUOYU_BOOTSTRAP_CODE=CHANGE_ME
